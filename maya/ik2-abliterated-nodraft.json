{
  "exe": "build/maya-ik2",
  "args": [
    "--model",
    "@MODEL_GGUF@",
    "--max-context",
    "131072"
  ],
  "env": {
    "IK2_KV": "fp8",
    "IK2_GATE_TILE": "64",
    "IK2_GATE_BF16": "1",
    "IK2_Q8_UNROLL": "1",
    "IK2_BATCH_PREFILL": "1"
  },
  "tokenizer": "ik2/tokenizer",
  "model_name": "inkling"
}
